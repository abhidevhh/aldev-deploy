{
  "include": [
    ".react-router/types/**/*",
    "**/*.mdx",
    "**/*.ts",
    "**/*.tsx"
  ],
  "extends": "../../tsconfig.base.json",
  "exclude": [
    "temp-*",
    "tests",
    "mocks",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "rootDir": ".",
    "typeRoots": [
      "./types",
      "../../node_modules/@types"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "Bundler",
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "paths": {
      "#app/*": [
        "./app/*"
      ],
      "#tests/*": [
        "./tests/*"
      ]
    }
  },
  "mdx": {
    "checkMdx": true
  }
}